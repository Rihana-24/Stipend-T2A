{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stipends-t2a",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  // Pages statiques (formulaire, espace équipe) : servies gratuitement, sans passer par le Worker.
  // Seules les routes /api/* exécutent du code.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "APP_URL": "https://stipends-t2a.VOTRE-SOUS-DOMAINE.workers.dev",
    "MAIL_FROM": "Talent2Africa <stipends@votre-domaine.org>",
    "ADMIN_EMAILS": "rihanatoubankole1703@gmail.com,rihanatou.bankole@mfap.talent2africa.com,ahonakpon.gbaguidi@mfap.talent2africa.com"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "stipends-t2a", "database_id": "3a482dd1-165c-4151-8da8-1df34ded67f0" }
  ],

  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "stipends-t2a-files" }
  ],

  // Quotidien 09:00 UTC : envoi du 10, relances J+3 / J+5, sauvegarde.
  // Toutes les 5 minutes : vide la file d'envoi d'emails (limite gratuite = 50 requêtes par exécution).
  "triggers": { "crons": ["0 9 * * *", "*/5 * * * *"] },

  "observability": { "enabled": true }
}
